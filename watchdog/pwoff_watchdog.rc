# 行人警示看守（PwOff watchdog）— init rc 片段
#
# 放置位置：/vendor/etc/init/pwoff_watchdog.rc
# 脚本位置：/vendor/bin/pwoff_watchdog.sh   （权限 0755，属主 root:root）
#
# 设计依据（全部取自本车 OTA 镜像 system/etc/selinux/plat_sepolicy.cil）：
#
#   (allow init shell_exec (file (read getattr map execute open)))
#   (allow init shell (process (transition)))
#   (allow shell zygote_exec (file (ioctl read getattr lock map execute execute_no_trans open)))
#
#   反证：su 域共 18 条 allow，其中 (allow su zygote_exec ...) = 0，所以 su 走不通。
#
# 为什么这里写 u:r:shell:s0，而镜像里 vrdata_config / boototamonitor 写的是 u:r:init:s0：
#   那两个脚本只做文件读写，不碰 app_process；
#   本脚本要执行 am（= app_process），init 域对 zygote_exec 只有 read/execute、没有 entrypoint，
#   并且镜像中没有 (type_transition init shell_exec ... shell)，所以 init 域里调 am 必然失败。
#   显式 seclabel 到 shell 域是唯一通的方式 —— 那正是 adb shell 所在的域，am 在里面天然可用。
#

service pwoff_watchdog /system/bin/sh /vendor/bin/pwoff_watchdog.sh
    class main
    user root
    group root system
    disabled
    seclabel u:r:shell:s0

# 用 boot_completed 而不是 on boot：on boot 阶段 AMS 还没就绪，am start 会失败。
on property:sys.boot_completed=1
    start pwoff_watchdog
